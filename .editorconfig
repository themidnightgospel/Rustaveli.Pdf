root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
max_line_length = 120

##
## Explicit types, never var. See docs/CONVENTIONS.md.
##
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error
dotnet_diagnostic.IDE0008.severity = error

##
## One top-level type per file, named after the type. Not expressible as a plain .editorconfig option, so it
## rides on StyleCop.Analyzers, which is referenced build-time-only and never ships. Every other StyleCop rule
## is off: the point is these two rules, not StyleCop's house style.
##
dotnet_diagnostic.SA1402.severity = error
dotnet_diagnostic.SA1649.severity = error

dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none

##
## Unused using directives. Warning rather than error: an import left behind by an edit in progress is a
## tidiness problem, not a structural one, so Debug reports it and the Release gate turns it into a failure.
## Reporting this on a command-line build depends on GenerateDocumentationFile — see Directory.Build.props.
##
dotnet_diagnostic.IDE0005.severity = warning

##
## Language style the codebase already follows, pinned so it stays that way.
##
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = when_on_single_line:silent
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_collection_expression = true:suggestion

dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error

# Private fields carry a leading underscore.
dotnet_naming_rule.private_fields_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_with_underscore.style = underscore_prefixed
dotnet_naming_rule.private_fields_with_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefixed.required_prefix = _
dotnet_naming_style.underscore_prefixed.capitalization = camel_case
