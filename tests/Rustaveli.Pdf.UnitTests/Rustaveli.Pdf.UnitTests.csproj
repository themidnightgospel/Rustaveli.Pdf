<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Property-based tests run on the modern runtime only: CsCheck ships for net8.0 and later. They exercise layout
    logic, which is the same source on both targets, so the net48 leg loses nothing it could uniquely catch.
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Compile Remove="PropertyBased\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rustaveli.Pdf\Rustaveli.Pdf.csproj" />
    <ProjectReference Include="..\..\src\Rustaveli.Pdf.Operations\Rustaveli.Pdf.Operations.csproj" />
  </ItemGroup>

</Project>