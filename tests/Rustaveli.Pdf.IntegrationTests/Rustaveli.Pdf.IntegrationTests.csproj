<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rustaveli.Pdf\Rustaveli.Pdf.csproj" />
    <ProjectReference Include="..\..\src\Rustaveli.Pdf.Operations\Rustaveli.Pdf.Operations.csproj" />
    <ProjectReference Include="..\..\src\Rustaveli.Pdf.Preview\Rustaveli.Pdf.Preview.csproj" />

    <!-- The preview is read over HTTP; .NET Framework keeps the client in an assembly of its own. -->
    <Reference Include="System.Net.Http" Condition="'$(TargetFramework)' == 'net48'" />
    <ProjectReference Include="..\..\src\Rustaveli.Pdf.Raster\Rustaveli.Pdf.Raster.csproj" />
    <ProjectReference Include="..\..\src\Rustaveli.Pdf.Shaping\Rustaveli.Pdf.Shaping.csproj" />

    <!-- A font embedded in the test assembly, for registering typefaces from resources. -->
    <EmbeddedResource Include="..\assets\fonts\NotoSansGeorgian-Regular.ttf" LogicalName="Fonts.Georgian.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\fonts\*.ttf" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>