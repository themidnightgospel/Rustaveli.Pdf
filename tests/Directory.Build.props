<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      Every test runs against both builds the library ships: net10.0 exercises the modern target, net48 exercises
      the netstandard2.0 build on .NET Framework, which is where polyfilled APIs and older runtime behaviour live.
      .NET Framework only exists on Windows, so other platforms run the net10.0 leg alone.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>

    <!--
      Tests find the repository from their own source files' paths, which a CI build maps to "/_/" to make the
      shipped packages reproducible. Tests ship nowhere, so they keep their real paths.
    -->
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test code shared by every test project, compiled into each: named inks and similar fixtures in code. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared\**\*.cs" LinkBase="Shared" />
    <Using Include="Rustaveli.Pdf.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared fixtures — fonts, images, documents — at assets/... beside every test assembly. -->
    <None Include="$(MSBuildThisFileDirectory)assets\**\*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
