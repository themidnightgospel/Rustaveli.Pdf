<Project>

  <!--
    Every package version in the repository is set here and nowhere else. Projects reference packages without a
    Version; a project that genuinely needs a different one uses VersionOverride, which makes the exception visible.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Shipped: runtime dependencies of the published packages. -->
  <ItemGroup>
    <!--
      Pinned deliberately. SkiaSharp 3.116.x raises the glibc floor to 2.29 and will not load on RHEL 8 or
      Debian 10 (mono/SkiaSharp#3201), and 3.119.0/3.119.1 dropped libfontconfig from the linux-arm64 binary
      (#3369). The 4.x line is clear of both. The two packages must move together.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <!-- The HarfBuzz release SkiaSharp 4.153 pairs with, so the two native libraries come from one build. -->
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.1.301" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
  </ItemGroup>

  <!--
    Shipped on netstandard2.0 only: the BCL's span and buffer-pool types, which .NET Framework lacks. The parsers
    and the PDF writer are built on them; net10.0 gets them from the runtime and has no dependencies at all.
    (docs/adr/0013-span-compatibility-package.md)
  -->
  <ItemGroup>
    <PackageVersion Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <!-- Build-time only: never reach a consumer. -->
  <ItemGroup>
    <PackageVersion Include="Polyfill" Version="11.4.2" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <!-- Tests. -->
  <ItemGroup>
    <!-- PDFium, as an independent renderer for visual snapshots: pages are never judged by our own reader. -->
    <PackageVersion Include="bblanchon.PDFium" Version="156.0.8076" />
    <!--
      Coverlet 10 counts each outcome of a condition as taken only when a test takes it; 6 counted some as taken that
      no test reached, so branch coverage measured by 6 read higher than it was.
    -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />

    <!--
      The behavioural oracle for the equivalence suite. Pinned to 2026.5.0, the last release distributed under an
      MIT grant: releases from 2026.6.0 onwards carry a licence that forbids using the software to develop a
      competing PDF library, which would cover this test suite. Never upgrade this reference.
    -->
    <PackageVersion Include="QuestPDF" Version="2026.5.0" />

    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <!-- Benchmarks. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- Fuzzing: libFuzzer's bridge to .NET, which the SharpFuzz tool in dotnet-tools.json instruments assemblies for. -->
  <ItemGroup>
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

</Project>
