<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage is measured over the shipped assemblies only. Code marked [ExcludeFromCodeCoverage] is left out, and every
  such exclusion must carry a Justification; generated code is excluded because no test can meaningfully target it.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Rustaveli.Pdf]*,[Rustaveli.Pdf.Raster]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>false</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
