<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Release is the gate: a warning there fails the build, so nothing ships with one outstanding. Debug leaves
      them as warnings so a half-finished edit still compiles and its tests can be run. Note this does not
      loosen the rules configured as errors in .editorconfig — explicit types and one-type-per-file fail in
      every configuration, because those are structural rather than advisory.
    -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      IDE0005 (unnecessary using directive) is silent on a command-line build unless the documentation file is
      generated — the compiler skips the analysis the rule reads from, so without this the warning appears only
      in an IDE. The two packable projects set it themselves because they genuinely ship their .xml; setting it
      here as well extends the rule to the tests and the sample, which are the projects where stale imports
      actually accumulate. CS1591 is off everywhere: the point is unused imports, not a doc comment per member.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      SA0001 fires from the compiler itself rather than against a file, so the severity set for [*.cs] in
      .editorconfig never reaches it. It only reports that XML comment analysis is off, which is deliberate:
      the two StyleCop rules this repository uses are structural and need no doc comments.
    -->
    <NoWarn>$(NoWarn);SA0001;CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Package identity, shared by everything that ships. Harmless on the test and sample projects, which set
    IsPackable to false.
  -->
  <PropertyGroup>
    <!-- Deliberately pre-1.0: the layout engine is settled but the public vocabulary is not. -->
    <Version>0.1.0-alpha</Version>
    <Authors>Rustaveli.Pdf contributors</Authors>
    <PackageTags>pdf;document;report;invoice;generation;layout;skiasharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>

    <!-- Ship symbols so a stack trace from a consumer's process is readable. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Referenced for exactly two rules — SA1402 (one type per file) and SA1649 (file name matches the type) —
      which plain .editorconfig cannot express. Every other StyleCop rule is switched off in .editorconfig; this
      repository is not adopting StyleCop's house style. PrivateAssets keeps it out of the shipped packages.
    -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>

  <!--
    netstandard2.0 lacks APIs the code uses freely on net10.0 — Index/Range, Math.Clamp, the ArgumentException
    guard methods and more. Polyfill is source-only: it compiles internal copies of exactly those APIs into each
    assembly for the old target and nothing for the new one, so the shipped packages keep zero runtime
    dependencies.

    Shipped projects only. The test projects see the core's copies through InternalsVisibleTo, and a second copy
    of their own would make every polyfilled call ambiguous between the two.
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Polyfill" Version="11.4.0" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Opts into the ThrowIfNull / ThrowIfLessThan family, which Polyfill leaves off by default. -->
    <PolyArgumentExceptions>true</PolyArgumentExceptions>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <!-- The licence itself travels as a PackageLicenseExpression, which nuget.org can read; only the README
         needs packing as a file. -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
