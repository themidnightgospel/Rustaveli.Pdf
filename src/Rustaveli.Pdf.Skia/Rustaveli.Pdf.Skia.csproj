<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Rustaveli.Pdf.Skia</RootNamespace>
    <PackageId>Rustaveli.Pdf.Skia</PackageId>
    <Description>SkiaSharp rendering backend for Rustaveli.Pdf.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsTrimmable>true</IsTrimmable>

    <!-- See the core project: without this the doc comments reach no consumer. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rustaveli.Pdf\Rustaveli.Pdf.csproj" />

    <!--
      Pinned deliberately. SkiaSharp 3.116.x raises the glibc floor to 2.29 and will not load on RHEL 8 or
      Debian 10 (mono/SkiaSharp#3201), and 3.119.0/3.119.1 dropped libfontconfig from the linux-arm64 binary
      (#3369). The 4.x line is clear of both.
    -->
    <PackageReference Include="SkiaSharp" Version="4.151.0" />

    <!--
      Referenced directly and unconditionally. The base SkiaSharp package does not carry the Linux native
      assets, and the trimmer drops native assets that arrive only transitively, so a direct reference is the
      only reliable way for Linux consumers to end up with a working binary.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.0" />
  </ItemGroup>

</Project>
