<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Rustaveli.Pdf</RootNamespace>
    <AssemblyName>Rustaveli.Pdf</AssemblyName>
    <PackageId>Rustaveli.Pdf</PackageId>
    <Description>A free, open source, fluent PDF generation library for .NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!--
      Annotated on the core library too, not only the rendering backend. Under the default partial trim mode an
      unannotated assembly is kept whole, so leaving this off would preserve the entire element tree and fluent
      API — by far the larger of the two assemblies — and would also exclude it from trim analysis.
    -->
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsTrimmable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>

    <!--
      Ship the XML documentation. Without this the library's doc comments reach nobody: consumers get no
      IntelliSense at all. CS1591 is suppressed because the obvious members — Padding, Bold, AlignLeft — carry
      their meaning in the name, and requiring a comment on each would bury the ones that say something.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rustaveli.Pdf.UnitTests" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.IntegrationTests" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.ConformanceTests" />

    <!-- Backends ship in lockstep with the core, so they may use its engine seams without making them public. -->
    <InternalsVisibleTo Include="Rustaveli.Pdf.Raster" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.Shaping" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.Operations" />
  </ItemGroup>

  <!--
    The last-resort typefaces: Latin, Greek and Cyrillic subsets of Noto Sans, built by eng/bundle-fonts.py. The SIL
    Open Font License they are distributed under travels in the package beside the MIT licence of the code.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\Bundled\*.ttf" LogicalName="Rustaveli.Pdf.Fonts.Bundled.%(Filename)%(Extension)" />
    <None Include="Fonts\Bundled\OFL.txt" Pack="true" PackagePath="licenses\NotoSans-OFL.txt" />
  </ItemGroup>

  <!-- Spans and array pools on .NET Framework; net10.0 has them built in (docs/adr/0013). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

</Project>
