<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Rustaveli.Pdf.Preview</RootNamespace>
    <PackageId>Rustaveli.Pdf.Preview</PackageId>
    <Description>Shows a Rustaveli.Pdf document in the browser as it is written, redrawn on every hot reload under dotnet watch, with layout failures explained on the page.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- See the core project: without this the doc comments reach no consumer. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rustaveli.Pdf.Raster\Rustaveli.Pdf.Raster.csproj" />

    <InternalsVisibleTo Include="Rustaveli.Pdf.UnitTests" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.IntegrationTests" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.ConformanceTests" />
  </ItemGroup>

</Project>
