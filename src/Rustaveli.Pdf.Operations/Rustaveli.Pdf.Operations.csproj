<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Rustaveli.Pdf.Operations</RootNamespace>
    <PackageId>Rustaveli.Pdf.Operations</PackageId>
    <Description>Combines, cuts down, stamps, attaches files to, protects and prepares for the web PDF files, Rustaveli.Pdf's own and any other.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsTrimmable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>

    <!-- See the core project: without this the doc comments reach no consumer. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rustaveli.Pdf\Rustaveli.Pdf.csproj" />

    <InternalsVisibleTo Include="Rustaveli.Pdf.UnitTests" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.IntegrationTests" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.ConformanceTests" />
  </ItemGroup>

</Project>
