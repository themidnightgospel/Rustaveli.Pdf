<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Rustaveli.Pdf.Shaping</RootNamespace>
    <PackageId>Rustaveli.Pdf.Shaping</PackageId>
    <Description>Shapes complex scripts — Arabic, Indic, Thai and others — for Rustaveli.Pdf through HarfBuzz.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsTrimmable>

    <!-- See the core project: without this the doc comments reach no consumer. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rustaveli.Pdf\Rustaveli.Pdf.csproj" />

    <InternalsVisibleTo Include="Rustaveli.Pdf.UnitTests" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.IntegrationTests" />
    <InternalsVisibleTo Include="Rustaveli.Pdf.ConformanceTests" />

    <!-- The release SkiaSharp's pinned version pairs with; the reason for that pin sits in Directory.Packages.props. -->
    <PackageReference Include="HarfBuzzSharp" />

    <!-- Referenced directly for the reason the Raster package references SkiaSharp's Linux assets directly. -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>

</Project>
