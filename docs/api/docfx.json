{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../src",
          "files": [ "**/*.csproj" ]
        }
      ],
      "dest": "reference",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      { "files": [ "index.md", "toc.yml" ] },
      { "files": [ "reference/**.yml", "reference/index.md" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Rustaveli.Pdf",
      "_appTitle": "Rustaveli.Pdf API",
      "_appFooter": "MIT licence",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
